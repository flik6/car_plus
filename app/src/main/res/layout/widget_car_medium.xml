<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Upper Half: Left Telemetry Info | Right Car Visual -->
    <LinearLayout
        android:id="@+id/widget_header_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_model_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="艾瑞泽8"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_plate_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_pill_bg"
                    android:ellipsize="end"
                    android:paddingStart="6dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1.5dp"
                    android:singleLine="true"
                    android:text="浙AQ014Q"
                    android:textColor="#B0B4BE"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/widget_fuel_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="54dp"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="24"
                    android:progressDrawable="@drawable/widget_fuel_progress" />

                <TextView
                    android:id="@+id/widget_fuel_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:singleLine="true"
                    android:text="24% · 210km"
                    android:textColor="#D1D1D6"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="已驻车"
                android:textColor="#8E9299"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95">

            <ImageView
                android:id="@+id/widget_car_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="车辆视图"
                android:paddingTop="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_car_arrizo8" />

            <LinearLayout
                android:id="@+id/widget_btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/widget_update_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:singleLine="true"
                    android:text="13:42 更新"
                    android:textColor="#787C86"
                    android:textSize="9.5sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="刷新车况"
                    android:src="@drawable/ic_widget_refresh"
                    android:tint="#8E9299" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Row: 4 Labeled One-Tap Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_btn_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_lock"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="锁车或解锁"
                android:src="@drawable/ic_widget_lock_closed" />

            <TextView
                android:id="@+id/widget_label_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="解锁"
                android:textColor="#B8BCC6"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_ac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_ac"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="开关空调"
                android:src="@drawable/ic_widget_fan" />

            <TextView
                android:id="@+id/widget_label_ac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="空调"
                android:textColor="#B8BCC6"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_flash"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="闪灯寻车"
                android:src="@drawable/ic_widget_flash" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="寻车"
                android:textColor="#B8BCC6"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_trunk"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="开关后备箱"
                android:src="@drawable/ic_widget_trunk" />

            <TextView
                android:id="@+id/widget_label_trunk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="后备箱"
                android:textColor="#B8BCC6"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
