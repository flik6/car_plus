<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Dedicated Top Header: Left Identity & Plate | Right Sync Chip (zero car overlap) -->
    <LinearLayout
        android:id="@+id/widget_header_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_model_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Qiri+"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_plate_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pill_bg"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingStart="7dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2.5dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#B4BCCB"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="7dp">

            <TextView
                android:id="@+id/widget_update_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="待同步"
                android:textColor="#9CA3B2"
                android:textSize="10sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="刷新车况"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#9CA3B2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle Showcase Row: Left Status & Energy | Right Unobstructed Car Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.96"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/widget_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="状态待同步"
                android:textColor="#9CA3B2"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/widget_fuel_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--% · --km"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_fuel_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4.5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_fuel_progress" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_car_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.12"
            android:contentDescription="车辆视图"
            android:paddingStart="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_car_arrizo8" />
    </LinearLayout>

    <!-- Bottom Row: 4 Evenly Spaced Labeled Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_btn_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_lock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="锁车或解锁"
                android:src="@drawable/ic_widget_lock_closed" />

            <TextView
                android:id="@+id/widget_label_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="解锁"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_ac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_ac"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="开关空调"
                android:src="@drawable/ic_widget_fan" />

            <TextView
                android:id="@+id/widget_label_ac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="空调"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_flash"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="闪灯寻车"
                android:src="@drawable/ic_widget_flash" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="寻车"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_trunk"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="开关后备箱"
                android:src="@drawable/ic_widget_trunk" />

            <TextView
                android:id="@+id/widget_label_trunk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="后备箱"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
