<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:padding="@dimen/widget_outer_padding">

    <!-- Logged-In Content: Range-Only + Unobstructed Car + Frameless Controls -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header: Model + Status/Range | Concentric 24dp Circular Refresh Pill -->
        <LinearLayout
            android:id="@+id/widget_header_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_header_inset"
            android:paddingTop="@dimen/widget_header_inset"
            android:paddingEnd="@dimen/widget_header_inset">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widget_model_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Qiri+"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_status_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="状态待同步"
                    android:textColor="#8E9299"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_btn_refresh"
                android:layout_width="@dimen/widget_pill_height"
                android:layout_height="@dimen/widget_pill_height"
                android:background="@drawable/widget_pill_bg">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="刷新车况"
                    android:src="@drawable/ic_widget_refresh"
                    android:tint="#8E9299" />
            </FrameLayout>
        </LinearLayout>

        <!-- Middle: Unobstructed Compact Car Stage (Range-Only Header) -->
        <ImageView
            android:id="@+id/widget_car_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:contentDescription="车辆视图"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_car_arrizo8" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/widget_header_inset"
            android:layout_marginEnd="@dimen/widget_header_inset"
            android:layout_marginBottom="4dp"
            android:background="#23262D" />

        <!-- Bottom 2 Frameless Quick Actions (Zero Boxy Frames) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_btn_lock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null">

                <FrameLayout
                    android:id="@+id/widget_halo_lock"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@null">

                    <ImageView
                        android:id="@+id/widget_icon_lock"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="锁车或解锁"
                        android:src="@drawable/ic_widget_lock_closed" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_ac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null">

                <FrameLayout
                    android:id="@+id/widget_halo_ac"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@null">

                    <ImageView
                        android:id="@+id/widget_icon_ac"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="开关空调"
                        android:src="@drawable/ic_widget_fan" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Logged-Out / Session-Expired Empty State -->
    <LinearLayout
        android:id="@+id/widget_logged_out_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Qiri+"
            android:textColor="#8E9299"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_logged_out_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="未登录"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_logged_out_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="轻触登录查看车况"
            android:textColor="#8E9299"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_btn_login"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_cta_pill_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:text="去登录"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
