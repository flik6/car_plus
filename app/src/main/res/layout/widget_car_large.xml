<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="14dp"
    android:paddingEnd="15dp"
    android:paddingBottom="14dp">

    <!-- Top Header: Model + Plate + Status | Compact Refresh Chip -->
    <LinearLayout
        android:id="@+id/widget_header_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_model_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Qiri+"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_plate_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/widget_pill_bg"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:paddingStart="7.5dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="7.5dp"
                    android:paddingBottom="2.5dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#B4BCCB"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="状态待同步"
                android:textColor="#9CA3B2"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_update_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="待同步"
                android:textColor="#9CA3B2"
                android:textSize="10sp" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="刷新车况"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#9CA3B2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Showroom Hero Vehicle Stage -->
    <ImageView
        android:id="@+id/widget_car_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:contentDescription="车辆视图"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_car_arrizo8" />

    <!-- Layered 3-Column Live Telemetry Strip (distinct surface from action buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_fuel_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="油量续航"
                android:textColor="#8E95A5"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_fuel_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--% · --km"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#282E3B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="空调状态"
                android:textColor="#8E95A5"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_climate_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#282E3B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="总里程"
                android:textColor="#8E95A5"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_odo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="-- km"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: 5 Flagship One-Tap Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_btn_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_lock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="锁车或解锁"
                android:src="@drawable/ic_widget_lock_closed" />

            <TextView
                android:id="@+id/widget_label_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="解锁"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_ac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_ac"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="开关空调"
                android:src="@drawable/ic_widget_fan" />

            <TextView
                android:id="@+id/widget_label_ac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="空调"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_flash"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="闪灯寻车"
                android:src="@drawable/ic_widget_flash" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="寻车"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_trunk"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="开关后备箱"
                android:src="@drawable/ic_widget_trunk" />

            <TextView
                android:id="@+id/widget_label_trunk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="后备箱"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_engine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon_engine"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="远程启停"
                android:src="@drawable/ic_widget_engine" />

            <TextView
                android:id="@+id/widget_label_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="启动"
                android:textColor="#A9B1C0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
